[Unit]
Description=RL PFP Overlay watcher (starts/stops overlay with Rocket League)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/rl-pfp-overlay/rl-pfp-watcher.sh
Restart=on-failure
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
